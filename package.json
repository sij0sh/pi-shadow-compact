{
  "name": "pi-shadow-compact",
  "version": "0.2.0",
  "type": "module",
  "description": "Silent soft-threshold compaction for Pi with native fallback",
  "keywords": ["pi-package"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sij0sh/pi-shadow-compact.git"
  },
  "bugs": {
    "url": "https://github.com/sij0sh/pi-shadow-compact/issues"
  },
  "homepage": "https://github.com/sij0sh/pi-shadow-compact#readme",
  "files": [
    "src",
    ".pi/shadow-compact.example.json",
    "README.md"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/shadow-compact.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
